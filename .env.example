# Variables de entorno - Parada 1 Bus
# Copiar a .env y completar con los valores reales.
#
#   cp .env.example .env
#
# El archivo .env esta en .gitignore: NO debe subirse al repositorio.

# ── Django ──────────────────────────────────────────────────────────────────
# OBLIGATORIA en produccion. Generar una con:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# La clave que estaba hardcodeada en settings.py quedo expuesta en el historial
# de git, asi que no se debe reutilizar ninguna variante de esa.
DJANGO_SECRET_KEY=cambiar-esta-por-una-generada-unicamente

# False en produccion. True solo en desarrollo.
DJANGO_DEBUG=True

# Lista separada por comas. Ej: parada1bus.com,www.parada1bus.com
DJANGO_ALLOWED_HOSTS=*

# ── Base de datos ───────────────────────────────────────────────────────────
# Con DB_ENGINE=postgresql el backend usa PostgreSQL. Sin esta variable usa
# SQLite, que es lo mas comodo para desarrollo rapido sin Docker.
#
# Dentro de Docker Compose, DB_HOST debe ser "db" (el nombre del service),
# no localhost: adentro del container, localhost es el propio container.
DB_ENGINE=postgresql
DB_NAME=parada1bus
DB_USER=parada1bus
DB_PASSWORD=cambiar-esta-password
DB_HOST=db
DB_PORT=5432

# ── Contacto ────────────────────────────────────────────────────────────────
WHATSAPP_NUMBER=5493584000000
EMAIL_CONTACTO=info@parada1bus.com

# ── Instagram ───────────────────────────────────────────────────────────────
INSTAGRAM_USER=parada1bus

# ── Solo desarrollo con Docker ──────────────────────────────────────────────
# Leido por vite.config.ts. Dentro de la red de compose el backend se llama
# "backend". Dejarlo vacio para correr el backend directo en la maquina.
VITE_PROXY_TARGET=http://backend:8000
